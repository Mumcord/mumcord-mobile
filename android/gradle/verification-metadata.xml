<!--
    Checksum pin for the one dependency that does not come from Google's repository or Maven
    Central: the Kotlin companion library of rustls-platform-verifier, published in a GitHub
    branch (see settings.gradle.kts). A changed file fails the build. Everything else is trusted
    as before; the trust rule matches every group except org.rustls.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
    <configuration>
        <verify-metadata>true</verify-metadata>
        <verify-signatures>false</verify-signatures>
        <trusted-artifacts>
            <trust group="^(?!org\.rustls$).*$" regex="true" />
        </trusted-artifacts>
    </configuration>
    <components>
        <component group="org.rustls" name="rustls-platform-verifier" version="0.2.0">
            <artifact name="rustls-platform-verifier-0.2.0.aar">
                <sha256 value="aa021794230fbc2f0be355999e2cf67398dd563de066a2e17001ffbd0b69101b" origin="downloaded from the repository in settings.gradle.kts" />
            </artifact>
            <artifact name="rustls-platform-verifier-0.2.0.pom">
                <sha256 value="78dcb69a1a20e91e72017de9a67104bba1874a7ecc8e6dcdfb2fe1a85de6b362" origin="downloaded from the repository in settings.gradle.kts" />
            </artifact>
        </component>
    </components>
</verification-metadata>
