<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to Mumble servers is the app's purpose. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Since Android 17 a server on the local network (home or office, private addresses) can
        only be reached with this permission. The first slice only declares it; asking for it
        with an explanation when such an address is used is a follow-up task.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- The secure storage is left out of every backup and transfer; see the two rule files. -->
    <application
        android:name=".MumcordApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
