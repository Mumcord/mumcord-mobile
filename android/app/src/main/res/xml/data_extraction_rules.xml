<!--
    Android 12 and newer. The secure storage (identities, server passwords) must stay on this
    device: it is left out of cloud backup and of device-to-device transfer. Its encryption key
    lives in the Android Keystore and cannot be copied anyway, so a copy would be unreadable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="securestore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="securestore/" />
    </device-transfer>
</data-extraction-rules>
