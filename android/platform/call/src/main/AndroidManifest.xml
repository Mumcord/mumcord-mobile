<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A voice session goes on in the background and with a locked screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The microphone service type is only allowed together with the microphone itself. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The session is shown to the phone system as a call that the app manages itself. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- The session's notification with Mute, Deafen and Leave. The app asks for it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".CallSessionService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />
    </application>

</manifest>
