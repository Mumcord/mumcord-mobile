#
# Pinned versions of the licence and SBOM tools, the same as the Mumcord repository uses.
# scripts/generate-notices.sh and scripts/generate-sbom.sh read this file; the release workflow
# installs the tools at these versions. Notices made with another cargo-about version can differ,
# so local runs warn about a mismatch.
CARGO_ABOUT_VERSION=0.9.2
CARGO_CYCLONEDX_VERSION=0.5.9
